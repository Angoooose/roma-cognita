    "data:validate": "npm run validate -w pipeline",
    "shot": "node scripts/shot.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "prettier": "*",
    "tsx": "*",
    "typescript": "~6.0.2",
    "vitest": "*"
  }
}
